{
  "name": "ios-development-course",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:wasm": "bash tools/build-wasm.sh",
    "pdf": "node tools/pdf.mjs",
    "validate": "node tools/validate-content.mjs",
    "verify-swift": "node tools/verify-swift.mjs",
    "engine-check": "node tools/engine-check.mjs",
    "preview-check": "node tools/preview-check.mjs",
    "diag-check": "node tools/diag-check.mjs",
    "conformance": "node tools/conformance.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "node tests/e2e/run.mjs",
    "e2e:webkit": "node tests/e2e/run.mjs --browser=webkit",
    "check": "node tools/validate-content.mjs && node tools/engine-check.mjs && vitest run && node tools/build.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.10",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.1",
    "vitest": "^3.2.4"
  }
}
